HIBP_API_KEY=
# Brave Search API key, for the dork module: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=
# Optional. Raises the GitHub API rate limit for the social module.
GITHUB_TOKEN=
# Anthropic API key, for the `investigate` planner. Without it, `investigate` still runs but
# falls back to breadth-first expansion, which is noisier.
ANTHROPIC_API_KEY=
# Optional. Which model plans the investigation. Defaults to claude-sonnet-5-5.
LANTERN_MODEL=
